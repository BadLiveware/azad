{
  "problemMatcher": [
    {
      "owner": "azad-cargo",
      "pattern": [
        {
          "regexp": "^(error|warning)(\\[(\\w+)\\])?: (.+)$",
          "severity": 1,
          "code": 3,
          "message": 4
        },
        {
          "regexp": "^\\s*--> (.+):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    }
  ]
}
