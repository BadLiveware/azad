# What the guest of Azad's microVM sandbox needs, merged over Cloud Hypervisor's guest configuration (see the
# Dockerfile). The kernel has no modules, so every option here is built in.

# Cloud Hypervisor boots vmlinux through PVH, has only virtio-pci devices, and powers off through ACPI when the guest
# init ends.
CONFIG_PVH=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y

# The kernel command line sends the console to ttyS0, whose end the host shows when a VM fails.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# The guest init comes in an uncompressed initramfs.
CONFIG_BLK_DEV_INITRD=y

# The guest init mounts proc, sysfs, devtmpfs and cgroup2 with the memory controller, and builds the root of each
# command on tmpfs.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y

# The host and the guest init talk over vsock.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# The disks of a run are attached while the VM runs: Cloud Hypervisor adds a PCI device and tells the guest through
# ACPI.
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y

# The root of an action is an EROFS image on virtio-pmem, which the guest maps with DAX, so it reads the host's page
# cache without a copy.
CONFIG_VIRTIO_PMEM=y
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_ZONE_DEVICE=y
CONFIG_DAX=y
CONFIG_FS_DAX=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y

# The run disk and the disks of cache volumes are ext4 on virtio-blk.
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y

# A VM for actions with network has a virtio-net device, which the kernel configures from its ip= argument.
CONFIG_VIRTIO_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y

# A guest that panics tells the host through pvpanic, so the host stops the VM at once.
CONFIG_PVPANIC=y
CONFIG_PVPANIC_PCI=y
